{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OCHISTKA",
  "version": "0.1.0",
  "identifier": "dev.ochistka.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OCHISTKA",
        "width": 900,
        "height": 712,
        "minWidth": 900,
        "minHeight": 712,
        "decorations": false,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "tray-panel",
        "create": false,
        "url": "index.html",
        "title": "OCHISTKA — быстрые действия",
        "width": 386,
        "height": 262,
        "minWidth": 386,
        "minHeight": 262,
        "visible": false,
        "focus": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {
      "resources/wallpapers/*.jpg": "wallpapers/",
      "resources/vpn-core/*": "vpn-core/",
      "resources/vpn-service/*": "vpn-service/",
      "resources/licenses/*": "licenses/"
    }
  }
}
