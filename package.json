{
  "name": "ochistka",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run tauri -w apps/desktop -- dev",
    "build": "npm run tauri -w apps/desktop -- build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test -w apps/desktop && cargo test --workspace",
    "check": "npm run check -w apps/desktop && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings"
  },
  "devDependencies": {
    "prettier": "^3",
    "prettier-plugin-svelte": "^3"
  }
}
